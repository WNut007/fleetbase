+/**
+ * Permission-name sets, one per permissions array. ember-can creates a new ability for every
+ * `can` check, and building a Set of all the user's permissions (766 for an admin) each time cost
+ * ~2 ms per check: a menu checks hundreds of items on every render, which stalled pages for
+ * seconds. The set is built once per permissions array and shared.
+ */
+const permissionSets = new WeakMap();
+
+export function permissionNames(permissions) {
+    if (!permissions || typeof permissions !== 'object') {
+        return new Set();
+    }
+
+    let names = permissionSets.get(permissions);
+    if (!names) {
+        names = new Set(Array.from(permissions, (permission) => permission?.name));
+        permissionSets.set(permissions, names);
+    }
+
+    return names;
+}
+
