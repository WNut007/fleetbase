+/**
+ * Valhalla distances are in the request's units ("kilometers" by default, or "miles"); convert to meters.
+ */
+export function toMeters(length, units = 'kilometers') {
+    const value = Number(length ?? 0);
+    if (!Number.isFinite(value)) {
+        return 0;
+    }
+
+    const perUnit = String(units ?? 'kilometers').startsWith('mi') ? 1609.344 : 1000;
+
+    return Math.round(value * perUnit);
+}
