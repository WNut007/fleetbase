     /**
+     * Whether any record of this morph type (in the current company, when there is one) has a
+     * custom field value; answered once per request. (ShipCode)
+     */
+    protected static function typeHasCustomFieldValues(string $subjectType): bool
+    {
+        $company = session('company');
+        $key     = 'shipcode.cfv_exists.' . $subjectType . '.' . ($company ?? '*');
+        $request = app('request');
+
+        if ($request->attributes->has($key)) {
+            return (bool) $request->attributes->get($key);
+        }
+
+        $query = CustomFieldValue::where('subject_type', $subjectType);
+        if ($company) {
+            $query->where('company_uuid', $company);
+        }
+        $exists = $query->exists();
+        $request->attributes->set($key, $exists);
+
+        return $exists;
+    }
+
+    /**
      * Return all custom field values keyed by normalized snake label (e.g., "order_number").
      * Uses CustomFieldValue::getCustomFieldLabelAttribute() to derive the label.
      *
@@ -212,6 +236,16 @@
      */
     public function getCustomFieldValues(bool $snakeKeys = true): array
     {
+        // ShipCode: resources call this for every row of a list, and loadMissing() then runs
+        // one query per row (206 on a 105-driver live list) even when nothing of this type has a
+        // custom field value. Check once per request and type; when there are none, mark the
+        // relation as loaded-and-empty so withCustomFields() does not load it either.
+        if (!$this->relationLoaded('customFieldValues') && !static::typeHasCustomFieldValues($this->getMorphClass())) {
+            $this->setRelation('customFieldValues', new \Illuminate\Database\Eloquent\Collection());
+
+            return [];
+        }
+
         $this->loadMissing('customFieldValues.customField');
 
         $out = [];
